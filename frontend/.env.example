# Copy this file to .env.production (or .env.local for local dev) and fill in
# the values from the deployed stack outputs (see outputs.json at the repo
# root after `./deploy.sh` has run).
#
# VITE_API_URL          -> stack output ApiUrl, no trailing slash
#                          e.g. https://abc123.execute-api.ap-southeast-1.amazonaws.com/Prod
# VITE_USER_POOL_ID      -> stack output UserPoolId
# VITE_USER_POOL_CLIENT_ID -> stack output UserPoolClientId
# VITE_REGION            -> fixed at ap-southeast-1 for this project

VITE_API_URL=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_REGION=ap-southeast-1
